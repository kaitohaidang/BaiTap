--cau 1
create procedure check_stock(p_id INT, p_qty INT)
language plpgsql 
as $$
declare 
   dem int;
begin
     select quantity into dem 
	 from inventory 
	 where product_id=p_id;
	 if dem < p_qty then
	 raise notice 'khong du hang trong kho';	
	 end if;
end;
$$;
call check_stock(1,10);
call check_stock(1,100);
