/*
3.	Cập nhật dữ liệu (6 điểm) Viết câu lệnh UPDATE để cập nhật lại total_amount trong
bảng
*/
Update Booking
set total_amount=r.room_price*(Booking.check_out_date-Booking.check_in_date)
from Room r
where r.room_id=Booking.room_id and
r.room_status ='Booked' and check_in_date<current_date

