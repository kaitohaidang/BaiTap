CREATE TABLE students (
    id SERIAL PRIMARY KEY,      -- ID tự động tăng
    full_name VARCHAR(100),     -- Họ và tên
    gender VARCHAR(10),         -- Giới tính
    birth_year INT,             -- Năm sinh
    major VARCHAR(50),          -- Chuyên ngành
    gpa DECIMAL(3,2)            -- Điểm trung bình (ví dụ: 3.60)
);
