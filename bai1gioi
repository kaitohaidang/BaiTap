--cau 1
EXPLAIN ANALYZE 
SELECT * FROM post 
WHERE is_public = TRUE AND content ILIKE '%du lịch%';

create index idx_post_content_lower
on post using gin (lower(content) gin_trgm_ops);
EXPLAIN ANALYZE 
SELECT * FROM post 
WHERE is_public = TRUE AND LOWER(content) LIKE LOWER('%du lịch%');
--cau 2
EXPLAIN ANALYZE 
SELECT * FROM post WHERE tags @> ARRAY['travel'];

create index idx_tags on post using gin (tags , gin_trgm_ops)

EXPLAIN ANALYZE 
SELECT * FROM post WHERE tags @> ARRAY['travel'];

--cau 3
-- a. Tạo Partial Index cho bài viết công khai gần đây
CREATE INDEX idx_post_recent_public
ON post(created_at DESC)
WHERE is_public = TRUE;


-- b. Kiểm tra hiệu suất với truy vấn 7 ngày gần nhất
EXPLAIN ANALYZE
SELECT * FROM post
WHERE is_public = TRUE AND created_at >= NOW() - INTERVAL '7 days';
--cau 4
-- a. Tạo chỉ mục tổng hợp (Composite Index)
CREATE INDEX idx_post_user_recent 
ON post(user_id, created_at DESC);


-- b. Kiểm tra hiệu suất khi xem bài đăng gần đây của bạn bè
-- Giả lập: Tìm 5 bài đăng mới nhất của người bạn có user_id = 2
EXPLAIN ANALYZE 
SELECT * FROM post 
WHERE user_id = 2 
ORDER BY created_at DESC 
LIMIT 5;

-- Giả lập nâng cao: Xem bài đăng mới nhất của một NHÓM bạn bè (user_id 2 và 3)
EXPLAIN ANALYZE 
SELECT * FROM post 
WHERE user_id IN (2, 3) 
ORDER BY created_at DESC 
LIMIT 10;






