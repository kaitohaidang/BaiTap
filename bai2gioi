--cau 1
create view v_revenue_by_region as
select c.region , sum(o.total_amount) as total_revenue
from customer c 
join orders o on c.customer_id=o.customer_id
group by c.region

SELECT * FROM v_revenue_by_region
ORDER BY total_revenue DESC
LIMIT 3;
--cau 2
CREATE VIEW order_detail_view AS
SELECT 
    order_id,
    customer_id,
    total_amount,
    order_date,
    status
FROM orders
WHERE status IN ('pending', 'processing')
WITH CHECK OPTION;
--cau3 
create view v_revenue_above_avg as
select region , total_revenue
from  v_revenue_by_region
where total_revenue >( select avg(total_revenue) as tb
                       from v_revenue_by_region )

