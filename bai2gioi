CREATE OR REPLACE FUNCTION manage_inventory()
RETURNS TRIGGER 
LANGUAGE plpgsql
AS $$
BEGIN
    -- Trường hợp 1: Có đơn hàng MỚI (Trừ kho)
    IF TG_OP = 'INSERT' THEN
        UPDATE products 
        SET stock = stock - NEW.quantity 
        WHERE id = NEW.product_id;
        RETURN NEW;
        
    -- Trường hợp 2: Đơn hàng bị THAY ĐỔI số lượng (Tính toán bù trừ)
    ELSIF TG_OP = 'UPDATE' THEN
        -- Thuật toán: Trả lại số lượng cũ (+ OLD), sau đó trừ đi số lượng mới (- NEW)
        UPDATE products 
        SET stock = stock + OLD.quantity - NEW.quantity 
        WHERE id = NEW.product_id;
        RETURN NEW;
        
    -- Trường hợp 3: Đơn hàng bị HỦY/XÓA (Cộng trả lại kho)
    ELSIF TG_OP = 'DELETE' THEN
        UPDATE products 
        SET stock = stock + OLD.quantity 
        WHERE id = OLD.product_id;
        RETURN OLD;
        
    END IF;
END;
$$;
CREATE TRIGGER trg_manage_inventory
AFTER INSERT OR UPDATE OR DELETE ON orders
FOR EACH ROW
EXECUTE FUNCTION manage_inventory();
