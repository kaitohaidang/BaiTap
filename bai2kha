--cau 1
select 
  p.product_name,
  sub.total_revenue
from products p
join (
   select product_id , sum(total_price) as total_revenue
   from orders o
   group by product_id
   order by total_revenue desc
   limit 1
) sub on p.product_id = sub.product_id;
--cau 2
select 
  p.category,
  sum(o.total_price) as total_revenue
from products p
join orders o on p.product_id =o.product_id
group by p.category;
