-- Lấy category của sản phẩm bán chạy nhất (nhóm theo product_id để tìm sản phẩm top 1)
SELECT p.category
FROM products p
JOIN orders o ON p.product_id = o.product_id
GROUP BY p.product_id, p.category
ORDER BY SUM(o.total_price) DESC
LIMIT 1

INTERSECT

-- Lấy các category có tổng doanh thu toàn danh mục > 3000
SELECT p.category
FROM products p
JOIN orders o ON p.product_id = o.product_id
GROUP BY p.category
HAVING SUM(o.total_price) > 3000;
