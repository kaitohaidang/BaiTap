
CREATE TABLE customers (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    credit_limit NUMERIC NOT NULL -- Hạn mức tín dụng tối đa
);

-- Tạo bảng đơn hàng
CREATE TABLE orders (
    id SERIAL PRIMARY KEY,
    customer_id INT REFERENCES customers(id), -- Khóa ngoại liên kết với bảng customers
    order_amount NUMERIC NOT NULL
);
create function check_credit_limit()
returns trigger
language plpgslq
as $$ 
begin
 declare
 v_credit_limit numeric;
 v_order_amount numeric;
 select credit_limit into v_credit_limit
 from customers
 where id = new.customer_id;

 select sum(order_amount) into v_order_amount
 from orders
 where id = new.customer_id;
 IF (v_current_total + NEW.order_amount) > v_limit THEN
        RAISE EXCEPTION 'Từ chối đơn hàng! Vượt quá hạn mức tín dụng. Hạn mức: %, Tổng hiện tại + Đơn mới: %', v_limit, (v_current_total + NEW.order_amount);
    END IF;
  return new;
end;

CREATE TRIGGER trg_check_credit
BEFORE INSERT ON orders
FOR EACH ROW
EXECUTE FUNCTION check_credit_limit();
