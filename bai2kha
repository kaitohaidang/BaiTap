import java.util.Scanner;

public class Bai1 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Nhập số tháng (1-12): ");

        // Kiểm tra nếu người dùng nhập đúng định dạng số nguyên
        if (scanner.hasNextInt()) {
            int thang = scanner.nextInt();

            // Cấu trúc switch-case để phân loại tháng
            switch (thang) {
                // Nhóm các tháng có 31 ngày
                case 1: case 3: case 5: case 7: case 8: case 10: case 12:
                    System.out.println("Tháng " + thang + " có 31 ngày.");
                    break;

                // Nhóm các tháng có 30 ngày
                case 4: case 6: case 9: case 11:
                    System.out.println("Tháng " + thang + " có 30 ngày.");
                    break;

                // Trường hợp tháng 2
                case 2:
                    System.out.println("Tháng 2 có 28 hoặc 29 ngày (tùy theo năm nhuận).");
                    break;

                // Trường hợp số ngoài phạm vi 1-12
                default:
                    System.out.println("Tháng không hợp lệ.");
                    break;
            }
        } else {
            System.out.println("Vui lòng nhập một số nguyên!");
        }

        scanner.close();
    }
}
