DROP TABLE IF EXISTS products;

-- Lệnh tạo bảng có tên là 'products'
CREATE TABLE products (
    id SERIAL PRIMARY KEY,    -- Tạo mã định danh (ID) tự động tăng, và là khóa chính của bảng
    name VARCHAR(100),        -- Cột tên sản phẩm, lưu trữ văn bản tối đa 100 ký tự
    price NUMERIC,            -- Cột giá tiền, lưu trữ số (có thể bao gồm số thập phân)
    discount_percent INT      -- Cột phần trăm giảm giá, lưu trữ số nguyên (ví dụ: 10, 20)
);

