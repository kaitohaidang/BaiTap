CREATE OR REPLACE PROCEDURE calculate_discount(p_id INT, OUT p_final_price NUMERIC)
LANGUAGE plpgsql
AS $$
DECLARE
    v_price NUMERIC;    -- Biến lưu giá gốc
    v_discount INT;     -- Biến lưu phần trăm giảm giá
BEGIN
    SELECT price, discount_percent 
    INTO v_price, v_discount
    FROM products 
    WHERE id = p_id;
    IF v_discount > 50 THEN
        v_discount := 50;
    END IF;
    p_final_price := v_price - (v_price * v_discount / 100.0);
    UPDATE products
    SET price = p_final_price
    WHERE id = p_id;

END;
$$;
