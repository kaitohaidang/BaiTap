
-- Tạo bảng tài khoản
CREATE TABLE accounts (
    account_id SERIAL PRIMARY KEY,
    customer_name VARCHAR(100),
    balance NUMERIC(12,2)
);

-- Tạo bảng lịch sử giao dịch
CREATE TABLE transactions (
    trans_id SERIAL PRIMARY KEY,
    account_id INT REFERENCES accounts(account_id),
    amount NUMERIC(12,2),
    trans_type VARCHAR(20), -- 'WITHDRAW' hoặc 'DEPOSIT'
    created_at TIMESTAMP DEFAULT NOW()
);

-- Nạp dữ liệu mẫu cho khách hàng "Nguyen Van A" với 1000.00
INSERT INTO accounts (customer_name, balance) 
VALUES ('Nguyen Van A', 1000.00);
-- Bước 1: Bắt đầu giao dịch
BEGIN;

-- Bước 2: Kiểm tra và Trừ tiền (Giả sử id=1)
-- Trong thực tế, ta thường dùng: WHERE account_id = 1 AND balance >= 200.00
UPDATE accounts 
SET balance = balance - 200.00 
WHERE account_id = 1;

-- Bước 3: Ghi log vào bảng transactions
INSERT INTO transactions (account_id, amount, trans_type) 
VALUES (1, 200.00, 'WITHDRAW');

-- Bước 4: Hoàn tất
COMMIT;

-- Kiểm tra kết quả: Balance còn 800.00 và có 1 dòng log
SELECT * FROM accounts;
SELECT * FROM transactions;
BEGIN;

-- Bước 1: Trừ tiền (Dự kiến 800.00 -> 700.00)
UPDATE accounts 
SET balance = balance - 100.00 
WHERE account_id = 1;

-- Bước 2: Cố ý chèn lỗi Khóa ngoại (account_id 999 không tồn tại)
INSERT INTO transactions (account_id, amount, trans_type) 
VALUES (999, 100.00, 'WITHDRAW'); 

-- Bước 3: Do lệnh INSERT trên báo lỗi, ta thực hiện hủy bỏ
ROLLBACK;

-- Bước 4: Kiểm chứng
-- Số dư vẫn phải là 800.00 (không bị trừ xuống 700.00)
SELECT * FROM accounts;
-- Không có dòng log mới nào được ghi
SELECT * FROM transactions;
-- Tổng số tiền đã rút từ Log
SELECT SUM(amount) FROM transactions WHERE trans_type = 'WITHDRAW' AND account_id = 1;

-- So sánh với (Số dư ban đầu - Số dư hiện tại)
SELECT (1000.00 - balance) AS total_deducted FROM accounts WHERE account_id = 1;
