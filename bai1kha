-- Xóa bảng cũ nếu đang tồn tại
DROP TABLE IF EXISTS products CASCADE;

-- Tạo bảng products theo yêu cầu
CREATE TABLE products (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100),
    price NUMERIC,
    last_modified TIMESTAMP DEFAULT CURRENT_TIMESTAMP -- Mặc định lấy thời gian lúc mới tạo
);
