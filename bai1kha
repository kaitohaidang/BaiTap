--cau 1
create view v_order_summary as
select c.full_name , o.total_amount ,o.order_date
from customer c
join orders o on c.customer_id=o.customer_id
--cau 2
SELECT * FROM v_order_summary;
--cau 3
create view v_high_value_orders as
select  o.order_id , o.total_amount, o.order_date
from orders o
where o.total_amount >=1000000

update v_high_value_orders
set total_amount=10000
where order_id=1

--cau4 
create view v_monthly_sales  as
select to_char(o.order_date,'yyyy-mm') as month,
       sum(total_amount) as total_revenue
from orders o 
group by to_char(o.order_date,'yyyy-mm')

