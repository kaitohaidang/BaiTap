-- Tạo bảng sản phẩm
CREATE TABLE products (
    product_id SERIAL PRIMARY KEY,
    name VARCHAR(50),
    stock INT
);

-- Tạo bảng bán hàng
CREATE TABLE sales (
    sale_id SERIAL PRIMARY KEY,
    product_id INT REFERENCES products(product_id),
    quantity INT
);

-- Nạp dữ liệu mẫu
INSERT INTO products (name, stock) VALUES ('iPhone 15', 5);
CREATE OR REPLACE FUNCTION check_stock_before_sale()
RETURNS TRIGGER AS $$
DECLARE
    current_stock INT;
BEGIN
    -- Lấy số lượng tồn kho hiện tại của sản phẩm
    SELECT stock INTO current_stock 
    FROM products 
    WHERE product_id = NEW.product_id;

    -- Kiểm tra điều kiện
    IF current_stock < NEW.quantity THEN
        -- Phát ra lỗi và ngăn chặn lệnh INSERT
        RAISE EXCEPTION 'Lỗi: Không đủ hàng trong kho! (Còn %, yêu cầu %)', 
        current_stock, NEW.quantity;
    ELSE
        -- Nếu đủ hàng, tự động trừ kho luôn cho tiện lợi
        UPDATE products 
        SET stock = stock - NEW.quantity 
        WHERE product_id = NEW.product_id;
    END IF;

    RETURN NEW;
CREATE TRIGGER trg_validate_sales_stock
BEFORE INSERT ON sales
FOR EACH ROW
EXECUTE FUNCTION check_stock_before_sale();
