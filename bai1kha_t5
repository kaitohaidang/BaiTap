--cau 1
create or replace procedure calculate_order_total(order_id_input INT, OUT total NUMERIC)
language plpgsql
as $$
begin
    select sum(quantity*unit_price) into total
	from order_detail o
	where order_id =order_id_input;
end;
$$;
