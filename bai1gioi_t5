create procedure adjust_salary(p_emp_id INT, OUT p_new_salary NUMERIC)
LANGUAGE plpgsql
AS $$
declare
  luong_hien_tai numeric;
  p_job_level int;
begin
   select salary ,job_level into luong_hien_tai ,  p_job_level 
   from employees
   where emp_id=p_emp_id;
   if p_job_level = 1 then
   p_new_salary:=luong_hien_tai + (luong_hien_tai * 0.05);
   elsif p_job_level = 2 then
   p_new_salary:= luong_hien_tai+luong_hien_tai*0.1;
   elsif p_job_level = 3 then
   p_new_salary:= luong_hien_tai+luong_hien_tai*0.15;
   else
   p_new_salary =luong_hien_tai;
   end if;
   update employees
   set salary=p_new_salary
   where emp_id=p_emp_id;
end;
$$;
call adjust_salary(1,null)
