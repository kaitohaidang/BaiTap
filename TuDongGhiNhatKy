-- Bước 1: Tạo bảng khách hàng
CREATE TABLE customers (
    customer_id SERIAL PRIMARY KEY,
    name VARCHAR(50),
    email VARCHAR(50)
);

-- Bước 2: Tạo bảng lưu vết (Log)
CREATE TABLE customer_log (
    log_id SERIAL PRIMARY KEY,
    customer_name VARCHAR(50),
    action_time TIMESTAMP
);
CREATE OR REPLACE FUNCTION log_customer_insert()
RETURNS TRIGGER AS $$
BEGIN
    -- Chèn tên khách hàng mới vào bảng log
    INSERT INTO customer_log (customer_name, action_time)
    VALUES (NEW.name, NOW());
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
CREATE TRIGGER trg_after_customer_insert
AFTER INSERT ON customers
FOR EACH ROW
EXECUTE FUNCTION log_customer_insert();
