create procedure calculate_total_sales (start_date DATE, end_date DATE, OUT total NUMERIC)
language plpgsql
as $$
begin
   select sum(s.amount) into total
   from Sales s
   where s.sale_date >=start_date and s.sale_date<=end_date;
end;
$$;
