-- 1. Tạo bảng sản phẩm (để có giá price)
CREATE TABLE products (
    product_id SERIAL PRIMARY KEY,
    product_name VARCHAR(100),
    price NUMERIC(10, 2)
);

-- 2. Tạo bảng đơn hàng (orders) theo yêu cầu
CREATE TABLE orders (
    order_id SERIAL PRIMARY KEY,
    product_id INT REFERENCES products(product_id),
    quantity INT,
    total_amount NUMERIC
);

-- 3. Chèn dữ liệu mẫu vào bảng products
INSERT INTO products (product_name, price) 
VALUES ('Chuột không dây', 200.00), ('Bàn phím cơ', 1500.00);

CREATE OR REPLACE FUNCTION calculate_total_amount()
RETURNS TRIGGER AS $$
DECLARE
    product_price NUMERIC;
BEGIN
    -- Lấy đơn giá từ bảng products dựa trên id sản phẩm đang chèn (NEW)
    SELECT price INTO product_price 
    FROM products 
    WHERE product_id = NEW.product_id;

    -- Tính tổng tiền và gán trực tiếp vào cột total_amount của bản ghi mới
    NEW.total_amount := NEW.quantity * product_price;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;
